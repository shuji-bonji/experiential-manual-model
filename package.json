{
  "name": "@shuji-bonji/experiential-manual-model",
  "version": "0.1.0",
  "description": "Data model for experiential operation manuals (screens with hotspots, screen flows, procedures, troubleshooting): TypeScript types, JSON Schema, validator and a converter from the 2021 experience_based_operation_explanation JSON. Independent of S1000D.",
  "keywords": ["manual", "operation-manual", "experiential", "interactive", "hotspot", "screen-flow", "json-schema", "typescript", "ietm"],
  "author": "shuji-bonji",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/shuji-bonji/experiential-manual-model.git" },
  "bugs": "https://github.com/shuji-bonji/experiential-manual-model/issues",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./schema/manual.schema.json": "./schema/manual.schema.json"
  },
  "files": ["dist", "schema", "examples"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src schema examples",
    "format:check": "prettier --check src schema examples",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.12"
  },
  "engines": { "node": ">=20.0.0" }
}
