{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shuji-bonji/experiential-manual-model/schema/manual.schema.json",
  "title": "Experiential manual",
  "description": "体験型操作マニュアルの共通データモデル（@shuji-bonji/experiential-manual-model）。S1000D に依存しない。",
  "type": "object",
  "required": ["id", "title", "version", "language", "topics"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "description": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scope"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "version": {
      "type": "object",
      "required": ["number"],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["id", "property", "values", "displayText"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "displayText": {
          "type": "string"
        }
      }
    },
    "admonition": {
      "type": "object",
      "required": ["level", "text"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": ["warning", "caution", "note"]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "to": {
          "$ref": "#/$defs/id"
        },
        "condition": {
          "type": "string"
        },
        "when": {
          "type": "object",
          "required": ["property", "values"],
          "additionalProperties": false,
          "properties": {
            "property": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "label": {
          "type": "string"
        }
      }
    },
    "topic": {
      "type": "object",
      "required": ["id", "kind", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["description", "procedure", "screenFlow", "troubleshooting"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "scopeRefs": {
          "$ref": "#/$defs/idList"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "screens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/screen"
          }
        },
        "startScreenRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["section", "para", "list", "table", "figure", "admonition"]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ordered": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "assetRef": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "enum": ["warning", "caution", "note"]
        },
        "scopeRefs": {
          "$ref": "#/$defs/idList"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "targetRef": {
          "$ref": "#/$defs/id"
        },
        "expected": {
          "type": "string"
        },
        "admonitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/admonition"
          }
        },
        "assetRefs": {
          "$ref": "#/$defs/idList"
        },
        "scopeRefs": {
          "$ref": "#/$defs/idList"
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "question": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "next"],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "next": {
                "$ref": "#/$defs/transition"
              }
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "required": ["id", "assetRef", "hotspots"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "caption": {
          "type": "string"
        },
        "assetRef": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "admonitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/admonition"
          }
        },
        "hotspots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hotspot"
          }
        },
        "scopeRefs": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "hotspot": {
      "type": "object",
      "required": ["id", "shape", "coords"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "shape": {
          "enum": ["rect", "circle", "poly"]
        },
        "coords": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "number"
          }
        },
        "action": {
          "enum": ["press", "input", "read"]
        },
        "transition": {
          "$ref": "#/$defs/transition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "rect"
              }
            },
            "required": ["shape"]
          },
          "then": {
            "properties": {
              "coords": {
                "minItems": 4,
                "maxItems": 4,
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "circle"
              }
            },
            "required": ["shape"]
          },
          "then": {
            "properties": {
              "coords": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "poly"
              }
            },
            "required": ["shape"]
          },
          "then": {
            "properties": {
              "coords": {
                "minItems": 6,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "assetFile": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "kind", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["image", "video", "model3d", "document"]
        },
        "source": {
          "$ref": "#/$defs/assetFile"
        },
        "display": {
          "$ref": "#/$defs/assetFile"
        },
        "alt": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        }
      }
    },
    "term": {
      "type": "object",
      "required": ["term", "definition"],
      "additionalProperties": false,
      "properties": {
        "term": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      }
    }
  }
}
